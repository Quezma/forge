#!/usr/bin/env bash
# Interactive wizard: pick what to install on this Mac. See README.md.
set -euo pipefail
REPO="$(cd "$(dirname "$0")" && pwd)"
export REPO
MODULES_DIR="${SETUP_MODULES_DIR:-$REPO/modules}"
# shellcheck source=lib/common.sh
. "$REPO/lib/common.sh"

usage() {
  cat <<'U'
Usage: ./setup [--yes] [--dry-run] [--only a,b] [--list] [-h]
  --yes       non-interactive: reuse saved choices, else module defaults
  --dry-run   print every mutating command as "+ <cmd>" instead of running it
  --only a,b  install exactly these modules (implies --yes)
  --list      show modules with their status and exit
U
}

YES=0 ONLY="" LIST=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --yes) YES=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --only) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; ONLY="$2"; YES=1; shift ;;
    --list) LIST=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done
if [ "$YES" = 0 ] && [ "$LIST" = 0 ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then YES=1; fi
[ "$YES" = 1 ] || INTERACTIVE=1
export DRY_RUN INTERACTIVE
ensure_brew_path

# --- load modules (metadata in arrays, functions sourced namespaced) ---------
N=0
for f in "$MODULES_DIR"/[0-9][0-9]-*.sh; do
  [ -e "$f" ] || continue
  # shellcheck disable=SC1090
  meta="$( . "$f"; printf '%s\n%s\n%s\n%s\n' "$MODULE_NAME" "$MODULE_DESC" "$MODULE_DEFAULT" "${MODULE_DEPS:-}" )"
  M_NAME[N]="$(echo "$meta" | sed -n 1p)"; M_DESC[N]="$(echo "$meta" | sed -n 2p)"
  M_DEF[N]="$(echo "$meta" | sed -n 3p)";  M_DEPS[N]="$(echo "$meta" | sed -n 4p)"
  # shellcheck disable=SC1090
  . "$f"
  N=$((N + 1))
done
[ "$N" -gt 0 ] || die "no modules found in $MODULES_DIR"

fn() { echo "${1//-/_}_$2"; }
idx_of() { local i; for ((i = 0; i < N; i++)); do [ "${M_NAME[$i]}" = "$1" ] && { echo "$i"; return 0; }; done; return 1; }
status_of() { "$(fn "${M_NAME[$1]}" status)" 2>/dev/null || echo missing; }

if [ "$LIST" = 1 ]; then
  for ((i = 0; i < N; i++)); do
    printf '%2d %-14s %-10s %s\n' $((i + 1)) "${M_NAME[$i]}" "$(status_of "$i")" "${M_DESC[$i]}"
  done
  exit 0
fi

# --- selection ---------------------------------------------------------------
for ((i = 0; i < N; i++)); do SEL[i]=0; done
select_names() { local n k; for n in "$@"; do k="$(idx_of "$n")" || die "unknown module: $n"; SEL[k]=1; done; }

if [ -n "$ONLY" ]; then
  # shellcheck disable=SC2046
  select_names $(echo "$ONLY" | tr ',' ' ')
else
  saved="$(choices_load)"
  if [ -n "$saved" ] || [ -f "$CHOICES_FILE" ]; then
    for n in $saved; do k="$(idx_of "$n")" && SEL[k]=1; done
  else
    for ((i = 0; i < N; i++)); do [ "${M_DEF[$i]}" = on ] && SEL[i]=1; done
  fi
fi

show_menu() {
  local i mark
  echo "Select modules (numbers toggle, a=all, n=none, Enter=go, q=quit):"
  for ((i = 0; i < N; i++)); do
    mark=" "; [ "${SEL[$i]}" = 1 ] && mark="x"
    printf '[%s] %2d %-14s %-10s %s\n' "$mark" $((i + 1)) "${M_NAME[$i]}" "$(status_of "$i")" "${M_DESC[$i]}"
  done
}

if [ "$YES" = 0 ]; then
  while :; do
    show_menu
    read -r -p "> " line || line=""
    [ -n "$line" ] || break
    for tok in $line; do
      case "$tok" in
        a) for ((i = 0; i < N; i++)); do SEL[i]=1; done ;;
        n) for ((i = 0; i < N; i++)); do SEL[i]=0; done ;;
        q) exit 0 ;;
        *[!0-9]*|"") warn "ignored: $tok" ;;
        *) if [ "$tok" -ge 1 ] && [ "$tok" -le "$N" ]; then k=$((tok - 1)); SEL[k]=$((1 - SEL[k])); else warn "ignored: $tok"; fi ;;
      esac
    done
  done
fi

# deps closure (repeat until nothing is added)
changed=1
while [ "$changed" = 1 ]; do
  changed=0
  for ((i = 0; i < N; i++)); do
    [ "${SEL[$i]}" = 1 ] || continue
    for d in ${M_DEPS[$i]}; do
      k="$(idx_of "$d")" || die "module ${M_NAME[$i]} depends on unknown module: $d"
      if [ "${SEL[$k]}" = 0 ]; then
        SEL[k]=1; changed=1; log "note: also selecting $d (needed by ${M_NAME[$i]})"
      fi
    done
  done
done

chosen=()
for ((i = 0; i < N; i++)); do [ "${SEL[$i]}" = 1 ] && chosen[${#chosen[@]}]="${M_NAME[$i]}"; done
if [ "${#chosen[@]}" -gt 0 ]; then choices_save "${chosen[@]}"; else choices_save; fi

# --- run ---------------------------------------------------------------------
FOLLOWUP_FILE="$(mktemp)"; export FOLLOWUP_FILE
trap 'rm -f "$FOLLOWUP_FILE"' EXIT
for ((i = 0; i < N; i++)); do RES[i]=""; NOTE[i]=""; done

for ((i = 0; i < N; i++)); do
  [ "${SEL[$i]}" = 1 ] || continue
  name="${M_NAME[$i]}"
  blocked=""
  for d in ${M_DEPS[$i]}; do
    k="$(idx_of "$d")"
    [ "${RES[$k]}" = ok ] || blocked="$d"
  done
  if [ -n "$blocked" ]; then RES[i]=skipped; NOTE[i]="dependency $blocked did not succeed"; continue; fi
  log "==> $name"
  set +e
  ( set -e; "$(fn "$name" install)" )
  rc=$?
  set -e
  if [ "$rc" -eq 0 ]; then RES[i]=ok; else RES[i]=failed; NOTE[i]="exit $rc"; fi
done

# rules: selected modules that succeeded + modules already installed (never a failed one)
rule_mods=()
for ((i = 0; i < N; i++)); do
  case "${RES[$i]}" in
    ok) rule_mods[${#rule_mods[@]}]="${M_NAME[$i]}" ;;
    "") [ "$(status_of "$i")" = installed ] && rule_mods[${#rule_mods[@]}]="${M_NAME[$i]}" ;;
  esac
done
write_rules ${rule_mods[@]+"${rule_mods[@]}"}

echo
echo "== summary$([ "$DRY_RUN" = 1 ] && echo ' (dry-run)') =="
failed=0
for ((i = 0; i < N; i++)); do
  [ -n "${RES[$i]}" ] || continue
  printf '%-8s %s%s\n' "${RES[$i]}" "${M_NAME[$i]}" "${NOTE[$i]:+  (${NOTE[$i]})}"
  [ "${RES[$i]}" = failed ] && failed=1
done
if [ -s "$FOLLOWUP_FILE" ]; then
  echo; echo "Manual follow-ups:"
  sort -u "$FOLLOWUP_FILE" | sed 's/^/ - /'
fi
exit "$failed"
